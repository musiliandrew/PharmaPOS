# Backend Configuration Template
PROJECT_NAME="Pharma SaaS POS API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Security & JWT Authentication
SECRET_KEY="your_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database (Asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/pharma_db"

# Redis Cache & Event PubSub
REDIS_URL="redis://localhost:6379/0"

# Safaricom Daraja M-Pesa Integration
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE="174379"
MPESA_CALLBACK_URL=""

# Pay Hero Kenya Integration (Multi-Tenant M-Pesa STK Push Gateway)
# Basic Auth Credentials from Pay Hero Kenya dashboard
PAYHERO_API_USERNAME=""
PAYHERO_API_PASSWORD=""
PAYHERO_API_URL="https://payhero.co.ke/api/v2"
PUBLIC_BACKEND_URL="https://pharma-backend-51917830461.us-central1.run.app"
